rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper: 是否為已登入使用者
    // ============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // ============================================================
    // Helper: 是否為管理員 (admin@hospital.com)
    // ============================================================
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'admin@hospital.com';
    }

    // ============================================================
    // Helper: 是否為指定員工本人
    // ============================================================
    function isStaff(staffId) {
      return isAuthenticated() && request.auth.uid == staffId;
    }

    // ============================================================
    // 1. NurseApp/Settings — 全域設定
    //    讀取：所有已登入使用者 (前端需要讀取班別、需求等設定)
    //    寫入：僅管理員
    // ============================================================
    match /NurseApp/Settings {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // 2. NurseApp/Staff — 員工完整資料（含 PII / 健康 / 財務欄位）
    //    讀取：僅管理員（員工同事看的是 NurseApp/StaffPublic 精簡投影）
    //    寫入：僅管理員（前端 saveGlobalStaff 會 batch 同步到 StaffPublic 與 StaffPrivate/{id}）
    //
    //    為什麼把 read 收緊：原本 isAuthenticated() 讓任何登入者都能讀到全院的
    //    is_pregnant_or_nursing / leave_status / accumulated_ot / email / gender …
    //    違反 PDPA §6（特種個資 — 醫療/健康 — 含懷孕、產假狀態）。
    // ============================================================
    match /NurseApp/Staff {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // 2a. NurseApp/StaffPublic — 同事用的精簡公開投影
    //    內容固定為 {staffData: [{staff_id, name, level, is_leader, is_active}, ...]}，
    //    不含任何 PII / 健康 / 財務欄位。
    //    讀取：所有已登入使用者（員工排班 UI 顯示同事姓名 / 職級會用到）
    //    寫入：僅管理員（由 saveGlobalStaff batch 同步寫入）
    // ============================================================
    match /NurseApp/StaffPublic {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // 2b. StaffPrivate/{staffId} — 員工自己的完整 row（頂層 collection）
    //    內容是該員工在 staffData 陣列裡那一筆的完整副本。
    //    讀取：admin 全部可讀；員工只能讀自己（uid 必須等於 docId）
    //    寫入：僅管理員（含 ProfileWizard 透過 /api/complete-profile 走 Admin SDK）
    //
    //    為什麼是頂層而非 NurseApp/StaffPrivate/{id}：Firestore 的 doc 路徑必須是
    //    偶數段，NurseApp/StaffPrivate/{id} 是 3 段（不合法）；頂層 StaffPrivate/{id}
    //    是 2 段（合法）。
    // ============================================================
    match /StaffPrivate/{staffId} {
      allow read: if isAdmin() || isStaff(staffId);
      allow write: if isAdmin();
    }

    // ============================================================
    // 3. Schedules/{yearMonth} — 月班表
    //    讀取：所有已登入使用者
    //    寫入：管理員可完整寫入；員工只能更新 finalizedSchedule
    // ============================================================
    match /Schedules/{yearMonth} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finalizedSchedule']);
    }

    // ============================================================
    // 4. archive_reports/{yearMonth} — 歷史結算報表
    //    讀取：僅管理員
    //    寫入：僅管理員 (前端寫入) 或後端 Admin SDK (自動結算)
    // ============================================================
    match /archive_reports/{yearMonth} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // 5. SelectionTurn/{yearMonth} — 目前輪到誰選班
    //    讀取：所有已登入使用者 (前端需要知道目前輪到誰)
    //    寫入：僅管理員 (啟動接力) 或後端 Admin SDK (Cron/AI)
    // ============================================================
    match /SelectionTurn/{yearMonth} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // 6. SelectionProgress/{yearMonth} — 已完成選班的員工清單
    //    讀取：所有已登入使用者
    //    寫入：僅管理員或後端 Admin SDK
    // ============================================================
    match /SelectionProgress/{yearMonth} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // 7. AI_Decision_Logs — AI 決策紀錄
    //    讀取：僅管理員
    //    寫入：僅管理員 (前端 App.jsx 以 admin 身份寫入)
    // ============================================================
    match /AI_Decision_Logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // 8. pending_activation/{tokenHash} — 一次性帳號啟用 / 密碼重設 token
    //    僅後端 Admin SDK 可存取（前端永遠不可讀寫）。
    //    明文 token 只在 Email 連結與使用者點擊時流通；Firestore 端只存 sha256 雜湊。
    // ============================================================
    match /pending_activation/{tokenHash} {
      allow read, write: if false;
    }

    // ============================================================
    // 9. access_logs/{logId} — 敏感欄位存取稽核日誌
    //    讀取：僅管理員（AccessLogPanel 用 onSnapshot 即時訂閱）
    //    寫入：永遠拒絕 — 只允許後端 Admin SDK 寫入（透過 api/_lib/accessLog.js）
    // ============================================================
    match /access_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // 預設：拒絕所有未明確允許的存取
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
