# ── Laravel 基本 ──
APP_NAME=nurse-schedule-php
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Firebase Admin SDK（鏡像 Vercel 後端的值）──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 含字面 \n 的單行字串即可，Firebase.php 會自動還原換行
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── 欄位加密：必須與 Node 後端同一把金鑰，否則解不開現有密文 ──
FIELD_ENC_KEY=

# ── Resend 寄信 ──
RESEND_API_KEY=
RESEND_FROM_EMAIL="護理排班系統 <onboarding@resend.dev>"

# ── CSRF / Cron server-to-server ──
CRON_SECRET=

# ── 啟用 / 重設 token TTL（小時，預設 2）──
ACTIVATION_TOKEN_TTL_HOURS=2

# ── 稽核日誌後端：firestore（預設）| mysql | both ──
ACCESS_LOG_BACKEND=firestore

# ── MySQL（僅 ACCESS_LOG_BACKEND 含 mysql 時才需要）──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Rate limiter 後端 ──
# 單機用 file 即可；多實例（負載平衡）務必用 redis，否則各機計數獨立 = 限流失效
CACHE_STORE=file
