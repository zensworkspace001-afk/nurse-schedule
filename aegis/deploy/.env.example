# 神盾計畫 地端部署設定 —— 複製成 .env 再修改（.env 不進版控）
# 機密（密碼、金鑰）不放這裡，放 secrets/（見 secrets/README.md）

# 映像版本：= package.sh 打包時的版本（install.sh 會自動寫入）
AEGIS_VERSION=1.0.0

# 使用者在瀏覽器輸入的網址（啟用 / 重設密碼信裡的連結也用它）。非 443 要帶 port
AEGIS_PUBLIC_URL=https://nurse-schedule.fab.local
AEGIS_HTTPS_PORT=443
AEGIS_HTTP_PORT=80
# 對外監聽的網卡位址（0.0.0.0 = 全部）
AEGIS_BIND=0.0.0.0

# api / web 映像的架構：正式主機 linux/amd64；Apple 晶片的 Mac 試用 linux/arm64（SQL Server 一律 amd64）
AEGIS_PLATFORM=linux/amd64

# Nginx ↔ API 的內部子網段。和廠內網段衝突時改掉（API 只信任這段送來的 X-Forwarded-For）
AEGIS_SUBNET=172.31.250.0/24

# 資料庫
AEGIS_DB_NAME=Aegis
MSSQL_TAG=2022-CU16-ubuntu-22.04
# SQL Server Express 本身上限約 1.4 GB 緩衝區；這裡限制整個行程
MSSQL_MEMORY_LIMIT_MB=2048

# API / 排班引擎（CP-SAT 執行緒數 ≤ API_CPUS）
API_CPUS=2
API_MEMORY=2g
ENGINE_WORKERS=2

# 院內 SMTP（不設 = 不寄信，啟用 / 重設連結交給管理員親自轉交）；密碼放 secrets/smtp_password
SMTP_HOST=
SMTP_PORT=25
SMTP_ENABLE_SSL=false
SMTP_USER=
SMTP_FROM=nurse-schedule@fab.local

# 備份（backup.sh）保留天數
BACKUP_RETENTION_DAYS=7
